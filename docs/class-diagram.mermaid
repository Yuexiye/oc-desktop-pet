classDiagram
    direction LR

    %% ===== 数据模型 =====
    class EventRecord {
        +float ts
        +float start_ts
        +float end_ts
        +str category
        +str scenario
        +str intent
        +str emotion
        +float intensity
        +str topic
        +str source
    }

    class Scene {
        +str scene_id
        +str label
        +str category
        +str scenario
        +list[str] tags
        +float first_ts
        +float last_ts
        +int count
        +float duration_min
        +str emotion_summary
        +list[str] topics
    }

    %% ===== 记忆层服务（A-E） =====
    class EventStream {
        +append(record: dict) None
        +read_all() list[dict]
        +read_since(ts: float) list[dict]
        +read_range(start: float, end: float) list[dict]
        +prune(max_days: int, max_entries: int) int
    }

    class CompanionMemory {
        +str _agent_id
        +Counter _today
        +list[dict] _history
        +str _last_topic
        +int _streak_days
        +record_activity(category: str) None
        +record_topic(text: str) None
        +record_event(category: str, scenario: str, intent: str, emotion: str, topic: str, start_ts: float, end_ts: float) None
        +read_events(days: int) list[dict]
        +prune_events() int
        +yesterday_summary() str
        +close() None
    }

    class SceneCluster {
        <<pure functions>>
        +cluster_events(events: list[dict], min_duration_min: int, gap_min: int) list[Scene]
    }

    class SceneMemory {
        +load() None
        +save() None
        +rebuild(events: list[dict]) int
        +find_matching(category: str, scenario: str, tags: list[str], max_results: int) list[Scene]
        +recent_scenes(n: int) list[Scene]
        +associate(current: dict, scenes: list[Scene]) Scene
        +prune(max_days: int, max_scenes: int) int
    }

    %% ===== 感知/调度（已有，少量扩展） =====
    class EmotionStateMachine {
        +str _current
        +float _intensity
        +trigger(emotion: str, intensity: float) None
        +tick() None
        +current 属性
    }

    class ProactiveScheduler {
        +set_scene_memory(scene_memory) None
        +tick() str
        +_try_intent(now: float, signals: dict) str
        +_try_recall(now: float, signals: dict) str
        +mark_conversation(user_reply: bool) None
    }

    %% ===== 表现/联动层（F-G） =====
    class PetStatusMapper {
        +str current
        +dict STATE_TO_SPRITE
        +dict STATE_TO_LIVE2D
        +dict STATE_TO_VRM
        +render_for(state: str, renderer) None
        +set_state(state: str) None
    }

    class PetStatusHTTPServer {
        +start() None
        +stop() None
    }

    class AvatarRenderer {
        <<abstract>>
        +load(character_id: str) bool
        +play_anim(anim: str, emotion: str, frame_range) None
        +set_emotion(emotion: str, intensity: float) None
        +look_at(x: int, y: int) None
        +set_scale(scale: float) None
        +set_facing(right: bool) None
    }

    %% ===== 关系 =====
    CompanionMemory --> EventStream : 委托写入
    SceneMemory ..> SceneCluster : 调用纯函数
    ProactiveScheduler ..> SceneMemory : 检索/联想
    PetStatusMapper ..> AvatarRenderer : 统一接口下发
    PetStatusHTTPServer ..> PetStatusMapper : GET 读取
    PetStatusHTTPServer ..> EventBus : POST 白名单转发
    HanakoMonitor ..> PetStatusMapper : tool_end → celebrating
