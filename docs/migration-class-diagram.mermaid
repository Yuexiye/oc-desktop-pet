classDiagram
    direction LR

    %% ── 主动搭话（P0-1/P0-2）──
    class ProactiveScheduler {
        +enabled: bool
        -_throttle: ProactiveThrottle
        -_generator: ProactiveGenerator
        +tick() str | None
        +mark_conversation(user_reply: bool) None
        +_collect_signals(now) dict
        +_try_intent(signals) str | None
        +_try_generated(signals) str | None
        +_try_recall(signals) str | None
    }
    class ProactiveThrottle {
        +hard_skip_seconds: float
        +half_life_minutes: float
        +daily_limit: int
        +can_fire(now) bool
        +record_trigger(now) None
        +record_ignored(now) None
        +_half_life_for(kind) float
        +_source_skip_probability(age, half_life) float
    }
    class ProactiveGenerator {
        +llm_channel: Callable
        +fallback_pool: list
        +generate(signals, memory_hits) str | None
        +_dedup(anti_repeat) bool
    }
    class ProactiveContracts {
        <<vocabulary>>
        +REASON_CHAT_DELIVERED: str
        +REASON_PASS_THROTTLED: str
        +STAGE_SOURCE_SELECTION: str
        +stage_for_reason(code) str
    }

    %% ── 记忆（P0-3/P0-4）──
    class HybridMemoryRecall {
        +recall(query, pool, top_k) list
        +_tokenize(text) list
        +_rrf_fuse(bm25_rank, cos_rank) list
    }
    class BM25Index {
        +k1: float = 1.5
        +b: float = 0.75
        +index(docs) None
        +score(query_tokens) list
    }
    class KeywordTokenizer {
        +fold_script(text) str
        +extract_keywords(text) set
        +tokenize(text) list
    }
    class EmbeddingService {
        <<optional P1-1>>
        +is_available() bool
        +embed(text) list | None
        +embed_batch(texts) list
    }
    class EventStream {
        +append(evt) None
        +read_since(ts) list
        +prune() int
        +normalize_fields(evt) dict
    }
    class SceneMemory {
        +find_matching(category, scenario, tags) list
        +associate(current, recent) Scene
        +rebuild(events) None
    }

    %% ── 专注（P0-5）──
    class FocusScorer {
        +score(user_text, emotion_reading) FocusScore
        +_signal_keyword(text) float | None
        +_signal_cadence(text) float | None
        +_signal_emotion(reading) float | None
    }
    class FocusStateMachine {
        +charge: float
        +mode: str
        +update(score, topic_changed) str
        +decay(dt) None
    }

    %% ── UI（P0-6/P0-7/P0-8）──
    class ChatPanel {
        +append_message(msg) None
        +show_thinking() None
        +hide_thinking() None
        +autoscroll() None
    }
    class ChatMessageView {
        +render(msg) None
    }
    class ThinkingDots {
        +start() None
        +stop() None
    }
    class FocusOverlay {
        +set_active(bool) None
        +set_strength(float) None
        +_breathe: QPropertyAnimation
    }
    class MemoryPanel {
        +show_events(events) None
        +show_scenes(scenes) None
        +show_facts(facts) None
    }

    %% 关系
    ProactiveScheduler --> ProactiveThrottle
    ProactiveScheduler --> ProactiveGenerator
    ProactiveScheduler --> ProactiveContracts
    ProactiveGenerator --> HybridMemoryRecall
    ProactiveGenerator --> ProactiveThrottle
    HybridMemoryRecall --> BM25Index
    HybridMemoryRecall --> KeywordTokenizer
    HybridMemoryRecall --> EmbeddingService : "cosine 路径（P1-1 填实现）"
    SceneMemory --> HybridMemoryRecall
    EventStream --> KeywordTokenizer
    FocusStateMachine --> FocusScorer
    ChatPanel --> ChatMessageView
    ChatPanel --> ThinkingDots
    FocusOverlay --> FocusStateMachine : "读 mode"
    MemoryPanel --> EventStream
    MemoryPanel --> SceneMemory
